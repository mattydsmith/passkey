{
  "name": "passkey-mgmt/delete-unknown",
  "mode": "bearer",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/auth/email/start",
        "body": { "email": "parity-delete-unknown@example.com" }
      },
      "expect": { "status": 200 },
      "capture": { "otpId": "$.body.otpId" }
    },
    {
      "request": {
        "method": "GET",
        "path": "/__test/last-otp?email=parity-delete-unknown@example.com"
      },
      "expect": { "status": 200 },
      "capture": { "code": "$.body.code" }
    },
    {
      "request": {
        "method": "POST",
        "path": "/auth/email/verify",
        "body": { "otpId": "{{otpId}}", "code": "{{code}}" }
      },
      "expect": { "status": 200 }
    },
    {
      "request": {
        "method": "DELETE",
        "path": "/auth/passkeys/AAAAAAAAAAAAAAAAAAAAAA"
      },
      "expect": {
        "status": 404,
        "body": { "error": "unknown_credential" }
      }
    }
  ]
}

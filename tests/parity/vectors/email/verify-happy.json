{
  "name": "email/verify-happy",
  "mode": "bearer",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/auth/email/start",
        "body": { "email": "parity-verify@example.com" }
      },
      "expect": {
        "status": 200,
        "body": {
          "otpId": { "type": "string", "nonEmpty": true },
          "expiresInSeconds": { "type": "number", "min": 1 }
        }
      },
      "capture": { "otpId": "$.body.otpId" }
    },
    {
      "request": {
        "method": "GET",
        "path": "/__test/last-otp?email=parity-verify@example.com"
      },
      "expect": {
        "status": 200,
        "body": { "code": { "type": "string", "nonEmpty": true } }
      },
      "capture": { "code": "$.body.code" }
    },
    {
      "request": {
        "method": "POST",
        "path": "/auth/email/verify",
        "body": { "otpId": "{{otpId}}", "code": "{{code}}" }
      },
      "expect": {
        "status": 200,
        "body": {
          "sessionToken": { "type": "string", "nonEmpty": true },
          "user": {
            "id": { "type": "string", "nonEmpty": true },
            "email": { "const": "parity-verify@example.com" }
          }
        }
      }
    }
  ]
}

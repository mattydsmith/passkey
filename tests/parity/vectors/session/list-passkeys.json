{
  "name": "session/list-passkeys",
  "mode": "bearer",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/auth/email/start",
        "body": { "email": "parity-list-passkeys@example.com" }
      },
      "expect": { "status": 200 },
      "capture": { "otpId": "$.body.otpId" }
    },
    {
      "request": {
        "method": "GET",
        "path": "/__test/last-otp?email=parity-list-passkeys@example.com"
      },
      "expect": { "status": 200 },
      "capture": { "code": "$.body.code" }
    },
    {
      "request": {
        "method": "POST",
        "path": "/auth/email/verify",
        "body": { "otpId": "{{otpId}}", "code": "{{code}}" }
      },
      "expect": { "status": 200 }
    },
    {
      "request": {
        "method": "POST",
        "path": "/auth/passkey/register/start",
        "body": {}
      },
      "expect": { "status": 200 },
      "capture": {
        "registrationId": "$.body.registrationId",
        "options": "$.body.options"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/auth/passkey/register/finish",
        "body": {
          "registrationId": "{{registrationId}}",
          "credential": { "$webauthn": "create", "options": "{{options}}" }
        }
      },
      "expect": { "status": 200 }
    },
    {
      "request": { "method": "GET", "path": "/auth/passkeys" },
      "expect": {
        "status": 200,
        "body": {
          "passkeys": {
            "array": {
              "minLength": 1,
              "items": {
                "id": { "type": "string", "nonEmpty": true },
                "createdAt": { "type": "number", "min": 0 }
              }
            }
          }
        }
      }
    }
  ]
}

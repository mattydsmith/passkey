{
  "name": "passkey/signin-invalid-credential",
  "mode": "bearer",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/auth/email/start",
        "body": { "email": "parity-signin-invalid@example.com" }
      },
      "expect": { "status": 200 },
      "capture": { "otpId": "$.body.otpId" }
    },
    {
      "request": {
        "method": "GET",
        "path": "/__test/last-otp?email=parity-signin-invalid@example.com"
      },
      "expect": { "status": 200 },
      "capture": { "code": "$.body.code" }
    },
    {
      "request": {
        "method": "POST",
        "path": "/auth/email/verify",
        "body": { "otpId": "{{otpId}}", "code": "{{code}}" }
      },
      "expect": { "status": 200 }
    },
    {
      "request": {
        "method": "POST",
        "path": "/auth/passkey/register/start",
        "body": {}
      },
      "expect": { "status": 200 },
      "capture": {
        "registrationId": "$.body.registrationId",
        "options": "$.body.options"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/auth/passkey/register/finish",
        "body": {
          "registrationId": "{{registrationId}}",
          "credential": { "$webauthn": "create", "options": "{{options}}" }
        }
      },
      "expect": { "status": 200 }
    },
    {
      "request": { "method": "POST", "path": "/auth/sign-out", "body": {} },
      "expect": { "status": 200 }
    },
    {
      "request": {
        "method": "POST",
        "path": "/auth/passkey/sign-in/start",
        "body": {}
      },
      "expect": { "status": 200 },
      "capture": {
        "signInId": "$.body.signInId",
        "signInOptions": "$.body.options"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/auth/passkey/sign-in/finish",
        "body": {
          "signInId": "{{signInId}}",
          "credential": {
            "$webauthn": "get",
            "options": "{{signInOptions}}",
            "corrupt": "signature"
          }
        }
      },
      "expect": {
        "status": 401,
        "body": { "error": "invalid_credential" }
      }
    }
  ]
}

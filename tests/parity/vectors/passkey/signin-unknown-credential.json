{
  "name": "passkey/signin-unknown-credential",
  "mode": "bearer",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/auth/passkey/sign-in/start",
        "body": {}
      },
      "expect": { "status": 200 },
      "capture": { "signInId": "$.body.signInId" }
    },
    {
      "request": {
        "method": "POST",
        "path": "/auth/passkey/sign-in/finish",
        "body": {
          "signInId": "{{signInId}}",
          "credential": {
            "id": "AAAAAAAAAAAAAAAAAAAAAA",
            "rawId": "AAAAAAAAAAAAAAAAAAAAAA",
            "type": "public-key",
            "response": {
              "clientDataJSON": "e30",
              "authenticatorData": "AAAA",
              "signature": "AAAA"
            }
          }
        }
      },
      "expect": {
        "status": 404,
        "body": { "error": "unknown_credential" }
      }
    }
  ]
}
